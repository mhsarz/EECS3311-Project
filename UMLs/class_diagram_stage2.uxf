-commands: CommandHistory
-storage: JsonStorage
-clock: Clock
-nameMatches: Map&lt;String, String&gt;
--
_+create(config: AppConfig): AgentController_
+addPantryItem(item: PantryItem, merge: boolean): boolean
+updatePantryItem(id: String, name: String, qty: double, unit: String,
      loc: StorageLocation, bestBefore: LocalDate): PantryItem
+removePantryItems(ids: Collection&lt;String&gt;): int
+checkExpiry(): List&lt;PantryItem&gt;
+generateRecipe(req: RecipeRequest): Recipe
+suggestSubstitutes(r: Recipe, ing: String): List&lt;Substitution&gt;
+useSubstitute(r: Recipe, ing: String, s: Substitution): boolean
+checkIngredients(r: Recipe): IngredientCheck
+getIngredientStatuses(r: Recipe): List&lt;IngredientStatus&gt;
+previewCooked(r: Recipe): CookPreview
+markCooked(r: Recipe): List&lt;String&gt;
+undo(): Optional&lt;String&gt;
+addToCart(items: List&lt;CartItem&gt;): List&lt;CartItem&gt;
+removeCartItems(names: Collection&lt;String&gt;): int
+checkSales(names: Collection&lt;String&gt;): SaleCheck
+applySales(check: SaleCheck): void
+addFlyerStore(store: String): String
+setStoreSelected(store: String, on: boolean): void
+uploadFlyer(file: Path, store: String, progress: Consumer&lt;String&gt;): FlyerRefresh
+refreshFlyers(progress: Consumer&lt;String&gt;): FlyerRefresh
+saveRecipe(r: Recipe): boolean
+removeRecipes(ids: Collection&lt;String&gt;): int
+rateRecipe(id: String, stars: int): void
+toggleFavourite(id: String): boolean
+searchHistory(query: String): List&lt;Recipe&gt;
+updateProfile(diet: String, allergies: List&lt;String&gt;,
      dislikes: List&lt;String&gt;, portions: int): void
+chat(message: String): String
+startProfileSetup(): String
+getAiStatus(): String
