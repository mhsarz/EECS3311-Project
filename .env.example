# .env.example - contains no real credentials.
# Copy this file to .env and put your real key in .env (which is git-ignored).

# Anthropic API key used by ClaudeClient
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE

# Model name sent to the Anthropic API
LLM_MODEL=claude-opus-5-5

# Maximum LLM calls per day, enforced by LLMClientProxy
LLM_DAILY_LIMIT=100

# Folder where JsonStorage keeps pantry, cart, history and profile files
DATA_DIR=data
